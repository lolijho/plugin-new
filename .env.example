# ──────────────────────────────────────────────────────────────
# WP Plugin Forge — environment variables
# Copy to .env and fill in. On Coolify, set these in the app's
# "Environment Variables" panel instead of committing a .env file.
# ──────────────────────────────────────────────────────────────

# Postgres 18 + pgvector connection string.
# On Coolify the host is the database service/resource name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wpforge

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# ── OpenRouter (required) ───────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Optional metadata sent to OpenRouter for attribution / rankings
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=WP Plugin Forge

# Default models per role (editable per-user in the UI). These are
# just seeds — the Settings page loads the live model list from OpenRouter.
DEFAULT_ARCHITECT_MODEL=anthropic/claude-opus-4.1
DEFAULT_CODER_MODEL=anthropic/claude-sonnet-4.5
DEFAULT_REVIEWER_MODEL=anthropic/claude-opus-4.1

# ── Embeddings (optional but recommended for semantic memory) ───
# Any OpenAI-compatible embeddings endpoint. If left empty, the app
# falls back to Postgres full-text search for memory retrieval.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# Must match the model's output dimension (text-embedding-3-small = 1536)
EMBEDDINGS_DIMENSIONS=1536

# ── App ─────────────────────────────────────────────────────────
NODE_ENV=production
# Set to "true" to allow open registration. If "false", only the first
# user can register (becomes admin) and further sign-ups are blocked.
ALLOW_REGISTRATION=true
